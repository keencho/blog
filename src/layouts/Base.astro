---
import { SITE } from '../consts';
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title?: string;
  description?: string;
  published?: Date;
  tags?: string[];
}
const { title, description, published, tags } = Astro.props;
const themeVars = `:root{--accent:${SITE.accent.light};--measure:${SITE.measure};--body-size:${SITE.bodySize}}`
  + `:root[data-theme='dark']{--accent:${SITE.accent.dark}}`
  + `@media(prefers-color-scheme:dark){:root:not([data-theme='light']){--accent:${SITE.accent.dark}}}`;
---
<!doctype html>
<html lang={SITE.lang} data-theme-preload>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Head title={title} description={description} published={published} tags={tags} />

    <style set:html={themeVars}></style>

    <!-- 폰트는 직접 들고 있다. 바깥 CDN 에 매달리지 않는다 -->
    {/* 본문 글꼴을 먼저 받는다. CSS 를 읽고 나서야 받으면 한 박자 늦는다.
        파일은 scripts/fonts.mjs 가 글에 쓰인 글자만 담아 굽는다 */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/pretendard-subset.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/ibm-plex-mono-latin-400-normal.woff2"
      crossorigin
    />
    <link rel="stylesheet" href="/fonts/pretendard.css" />

    <script is:inline>
      // 첫 그림 전에 테마를 정해 깜빡임을 막는다
      (function () {
        try {
          var d = document.documentElement.dataset;
          var t = localStorage.getItem('theme');
          if (t === 'dark' || t === 'light') d.theme = t;
        } catch (e) {}
      })();
    </script>

    <script is:inline>
      /* 옛 블로그(Jekyll · Chirpy)가 깔아둔 PWA 서비스 워커를 지운다.
         그게 남아 있으면 새 사이트를 올려도 캐시에 있는 옛 index.html 이 나온다.
         /sw.js 쪽에도 자폭하는 워커를 둬서 양쪽에서 막는다.
         옛 방문자가 전부 한 번씩 다녀간 뒤(몇 달)에는 이 블록을 지워도 된다. */
      (function () {
        if (!('serviceWorker' in navigator)) return;
        navigator.serviceWorker
          .getRegistrations()
          .then(function (rs) {
            rs.forEach(function (r) {
              r.unregister();
            });
          })
          .catch(function () {});
        if (window.caches) {
          caches
            .keys()
            .then(function (ks) {
              ks.forEach(function (k) {
                if (k.indexOf('chirpy') === 0) caches.delete(k);
              });
            })
            .catch(function () {});
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">본문으로</a>
    <Header />
    <main id="main" class="shell">
      <slot />
    </main>
    <Footer />
  </body>
</html>
