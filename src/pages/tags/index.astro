---
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/posts';
import { slugify } from '../../lib/slug';

const posts = await getPosts();
const count = new Map<string, number>();
for (const p of posts) for (const t of p.data.tags) count.set(t, (count.get(t) ?? 0) + 1);
const tags = [...count].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'ko'));
---
<Base title="태그">
  <h1>태그<span class="n">{tags.length}</span></h1>
  <p class="tags">
    {tags.map(([name, n]) => (
      <a href={`/tags/${slugify(name)}/`}>{name}<span class="n">{n}</span></a>
    ))}
  </p>
</Base>

<style>
  h1 { font-size: 1.5rem; margin: 0 0 1.8rem; letter-spacing: -0.02em; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.5rem 1.1rem; margin: 0; }
  .tags a {
    text-decoration: none;
    font-size: 0.94rem;
    border-bottom: 1px solid var(--rule);
  }
  .tags a:hover { border-bottom-color: var(--accent); }
  .n {
    font-size: 0.78rem;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    color: var(--ink-faint);
    margin-left: 0.3em;
  }
  h1 .n { font-size: 0.82rem; margin-left: 0.5em; }
</style>
