---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import '../../styles/prose.css';
import { full, iso } from '../../lib/date';
import Toc from '../../components/Toc.astro';
import PostEnhance from '../../components/PostEnhance.astro';
import Lightbox from '../../components/Lightbox.astro';
import { slugify } from '../../lib/slug';
import { summarize } from '../../lib/summary';
import { getPosts, buildSeries, related } from '../../lib/posts';
import PostFooter from '../../components/PostFooter.astro';

export async function getStaticPaths() {
  const posts = await getPosts();
  const series = buildSeries(posts);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      // 시리즈면 앞뒤 편, 아니면 태그가 겹치는 글
      series: series.get(post.id) ?? null,
      related: related(post, posts, 3),
    },
  }));
}

const { post, series, related: relatedPosts } = Astro.props;
const { Content, headings } = await render(post);

// 공유했을 때 보일 요약 — 본문에서 뽑는다 (lib/summary.ts 가 소제목·목차 줄을 거른다)
const summary = summarize(post.body, post.data.title);

const ymd = full(post.data.date);
---
<Base
  title={post.data.title}
  description={summary}
  published={post.data.date}
  updated={post.data.updated}
  tags={post.data.tags}
>
  <article>
    <header class="head">
      <h1>{post.data.title}</h1>
      <p class="meta">
        <time datetime={iso(post.data.date)}>{ymd}</time>
        {post.data.tags.length > 0 && (
          <span class="tags">
            {post.data.tags.map((t) => (
              <a href={`/tags/${slugify(t)}/`}>{t}</a>
            ))}
          </span>
        )}
      </p>
    </header>

    <Toc headings={headings} />

    <div class="prose">
      <Content />
    </div>

    <PostEnhance />
    <Lightbox />

    <PostFooter series={series} related={relatedPosts} current={post.id} />
  </article>
</Base>

<style>
  .head { margin-bottom: 2.6rem; }



  h1 {
    margin: 0 0 0.5rem;
    font-size: 1.85rem;
    font-weight: 700;
    line-height: 1.38;
    letter-spacing: -0.022em;
    word-break: keep-all;
  }

  .meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.9rem;
    font-size: 0.85rem;
    color: var(--ink-dim);
  }
  .tags { display: flex; gap: 0.55rem; }
  .tags a {
    color: var(--ink-faint);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  .tags a:hover { color: var(--accent); border-bottom-color: var(--accent); }

</style>
