---
import Base from '../layouts/Base.astro';
---
<Base title="찾을 수 없음">
  <div class="box">
    <p class="code">404</p>
    <h1>그런 주소는 없습니다</h1>
    <p class="help">
      주소가 바뀌었거나 글이 지워졌을 수 있습니다.
      <a href="/">글 목록</a>에서 찾아보세요.
    </p>
  </div>
</Base>

<style>
  .box { padding: 4rem 0 6rem; }
  .code {
    margin: 0 0 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.86rem;
    color: var(--ink-faint);
    letter-spacing: 0.05em;
  }
  h1 { font-size: 1.5rem; margin: 0 0 0.8rem; letter-spacing: -0.02em; }
  .help { margin: 0; color: var(--ink-dim); word-break: keep-all; }
  .help a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.22em;
  }
</style>
