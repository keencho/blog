---
import { SITE } from '../consts';
const year = new Date().getFullYear();
---
<footer class="site">
  <div class="shell">
    <span>{year} {SITE.author}</span>
    <a href="/feed.xml">RSS</a>
  </div>
</footer>

<style>
  .site {
    margin-top: 5rem;
    padding-block: 1.6rem 3rem;
    font-size: 0.84rem;
    color: var(--ink-faint);
  }
  .shell {
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    border-top: 1px solid var(--rule);
    padding-top: 1.3rem;
  }
  a { color: inherit; text-decoration: none; }
  a:hover { color: var(--ink-dim); }
</style>
