---
import type { MarkdownHeading } from 'astro';

interface Props { headings: MarkdownHeading[] }
const { headings } = Astro.props;

// h2~h4 를 담는다. 글마다 쓰는 깊이가 달라서 h3 에서 끊으면
// 네 단계를 쓰는 글의 목차가 절반으로 줄어든다 (실측: 11개 → 5개)
const items = headings.filter((h) => h.depth >= 2 && h.depth <= 4);
---
{items.length > 1 && (
  <>
    <nav class="toc" aria-labelledby="toc-label" data-toc>
      <details open>
        <summary id="toc-label">목차<span class="n">{items.length}</span></summary>
        <ol>
          {items.map((h) => (
            <li data-depth={h.depth}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </details>
    </nav>

    {/* 목차가 화면 밖으로 밀려났을 때만 뜨는 단추.
        글 길이나 제목 수로 재지 않는다 — 실측상 제목이 6개뿐인데 36화면짜리
        글이 있어서, 제목 수로 거르면 긴 글 26편을 놓친다.
        목차가 눈앞에 있으면 필요 없고 없으면 필요하다, 그게 전부다 */}
    <div class="fab" hidden data-toc-fab>
      {/* 아이콘은 viewBox 와 그리는 크기를 1:1 로 맞추고 선을 짝수로 둔다.
          20 짜리를 15px 로 줄여 1.5 를 쓰면 1.13px 이 되어 양옆에 반투명
          픽셀이 깔리고, 그게 물 빠진 색처럼 흐릿하게 보인다 */}
      <button type="button" class="up" aria-label="맨 위로" data-toc-top>
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
          <path d="M10 16V5M4 11l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2" />
        </svg>
      </button>
      {/* 선 길이를 길게·짧게·길게 로 두면 그 자체가 목차 구조를 그린다.
          길이가 다르니 햄버거 메뉴로 읽히지도 않는다 */}
      <button type="button" class="open" aria-expanded="false" aria-label="목차 열기" data-toc-open>
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
          <path d="M3 5h14M7 10h8M3 15h14" stroke="currentColor" stroke-width="2" />
        </svg>
      </button>
    </div>

    <div class="sheet" hidden data-toc-sheet>
      <div class="dim" data-toc-dim></div>
      <div class="panel" role="dialog" aria-modal="true" aria-label="목차">
        <div class="bar">
          <span class="title">목차</span>
          <button type="button" class="close" data-toc-close>닫기</button>
        </div>
        <div class="list" data-toc-list></div>
      </div>
    </div>
  </>
)}

<style>
  /* ── 모바일·태블릿 — 제목 아래 접어둔다 ─────────────── */
  .toc {
    margin: 0 0 2.4rem;
    border-left: 2px solid var(--rule);
    padding-left: 1rem;
    font-size: 0.9rem;
  }

  summary {
    cursor: pointer;
    color: var(--ink-dim);
    list-style: none;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    user-select: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: '';
    width: 0.4em;
    height: 0.4em;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg) translateY(-0.15em);
    margin-left: 0.1rem;
  }
  details[open] > summary::after { transform: rotate(-135deg) translateY(-0.1em); }
  summary:hover { color: var(--ink); }

  .n {
    font-size: 0.78em;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }

  ol {
    list-style: none;
    margin: 0.55rem 0 0;
    padding: 0;
  }
  li { line-height: 1.75; word-break: keep-all; }
  li[data-depth='3'] { padding-left: 0.9rem; font-size: 0.95em; }
  li[data-depth='4'] { padding-left: 1.8rem; font-size: 0.92em; }

  a {
    color: var(--ink-dim);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  a:hover { color: var(--ink); }
  a[data-current] {
    color: var(--accent);
    font-weight: 600;
  }

  /* 목차가 길면 목차 안에서 민다. 그냥 두면 제목이 28개인 글에서
     목차 높이가 761px 이라 첫 화면이 통째로 목차가 되고 본문이 한 줄도 안 보인다 */
  details > ol {
    max-height: 60vh;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* ── PC — 본문 오른쪽 바깥에 띄운다 ────────────────── */
  /* 85rem(1360px) 부터 켠다. 더 낮추면 목차가 같이 쪼그라드는데,
     실측상 1100px 에서는 폭이 106px 까지 좁아져 한 항목이 7줄로 쌓인다 */
  @media (min-width: 85rem) {
    .toc {
      position: fixed;
      top: 7.5rem;
      left: calc(50% + var(--measure) / 2 + 2.5rem);
      /* 15rem 에서 거의 포화한다 — 실측: 216px 36줄 · 240px 32줄 · 300px 31줄 */
      width: min(15rem, calc(50vw - var(--measure) / 2 - 4rem));
      max-height: calc(100vh - 11rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      margin: 0;
      font-size: 0.84rem;
      scrollbar-width: thin;
    }
    /* PC 에서는 항상 펼친 상태로 두고 접기 화살표를 감춘다 */
    summary { pointer-events: none; }
    summary::after { display: none; }
    li { line-height: 1.6; }
    ol { margin-top: 0.6rem; }
    /* 바깥 상자가 이미 밀리므로 안쪽 스크롤은 끈다 */
    details > ol { max-height: none; overflow: visible; }
    /* 목차가 늘 떠 있으니 단추가 설 자리가 없다 */
    .fab, .sheet { display: none; }
  }

  /* ── 떠다니는 단추 — 왼쪽 맨 위로, 오른쪽 목차 ──────── */
  .fab {
    /* 테두리 색. --rule 로 두면 바탕과 대비가 1.2 라 선이 안 보인다.
       이 섞은 색은 라이트 3.3 · 다크 4.0 으로 양쪽 다 UI 기준(3:1)을 넘는다 */
    --fab-line: color-mix(in srgb, var(--ink-faint) 60%, var(--ink-dim));

    position: fixed;
    /* 바탕색 링을 뺀 대신 본문에서 조금 더 띄운다 */
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 20;
    display: flex;
    overflow: hidden;
    color: var(--ink-dim);
    background: var(--bg-float);
    border: 1px solid var(--fab-line);
    /* 999px 은 본문 안 「전부 보기」 단추에만 쓰던 값이다.
       이 블로그가 즐겨 쓰는 모서리는 3~5px 이라 떠다니는 것도 각진 쪽이 맞다 */
    border-radius: 8px;
    /* 바탕색 링(0 0 0 4px var(--bg))은 쓰지 않는다. 글이 네 번에 한 번꼴로
       코드블록 위에 걸리는데 그 바탕은 --bg-sunk 라, 링 색이 어긋나 띠로 보인다.
       테두리 대비가 라이트 3.3 · 다크 4.0 이라 혼자서도 충분히 선다 */
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.16);
  }
  .fab[hidden] { display: none; }

  .fab button {
    display: grid;
    place-items: center;
    /* rem 으로 두면 2.6rem = 41.6px 이 되어 단추가 반픽셀 자리에 앉고,
       그 위에 그린 2px 선이 양옆으로 쪼개져 흐릿해 보인다. 정수 px 로 둔다.
       44 는 터치 기준(Apple HIG · WCAG AAA)이 말하는 최소 크기이기도 하다 */
    width: 44px;
    height: 44px;
    padding: 0;
    color: inherit;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .fab button:hover { color: var(--ink); background: var(--bg-sunk); }
  /* 칸막이를 border 로 두면 box-sizing 때문에 안쪽 폭이 43px(홀수)이 되고,
     가운데 정렬한 아이콘이 다시 반픽셀 자리에 앉는다. 자리를 안 먹는 선으로 그린다 */
  .fab .open { box-shadow: inset 1px 0 0 var(--fab-line); }

  /* ── 아래에서 올라오는 목차 ──────────────────────── */
  .sheet[hidden] { display: none; }
  .dim {
    position: fixed;
    inset: 0;
    z-index: 30;
    background: rgb(0 0 0 / 0.32);
    animation: 번짐 0.16s ease-out;
  }
  .panel {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 31;
    display: flex;
    flex-direction: column;
    max-height: 72vh;
    padding: 0 1.15rem 1.15rem;
    background: var(--bg);
    border-top: 1px solid var(--rule);
    border-radius: 12px 12px 0 0;
    /* 기척 없이 툭 나타나면 어디서 온 건지 모른다. 짧게 올라오는 것만으로
       「화면 밑에 숨어 있던 것」이 읽힌다. 이 블로그의 다른 모션도 0.1~0.12초다.
       움직임 줄이기 설정은 base.css 가 전역으로 끈다 */
    animation: 올라옴 0.16s ease-out;
  }
  @keyframes 올라옴 { from { transform: translateY(100%); } }
  @keyframes 번짐 { from { opacity: 0; } }
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.7rem 0 0.55rem;
    border-bottom: 1px solid var(--rule);
  }
  .bar .title {
    font-size: 0.85rem;
    color: var(--ink-dim);
  }
  .bar button {
    font: inherit;
    font-size: 0.85rem;
    color: var(--ink-dim);
    background: none;
    border: 0;
    padding: 0.25rem 0;
    cursor: pointer;
  }
  .bar button:hover { color: var(--ink); }
  .list {
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-top: 0.55rem;
    font-size: 0.92rem;
  }
  .list :global(ol) { margin-top: 0; }
</style>

<script>
  const toc = document.querySelector('[data-toc]');
  if (toc) {
    const details = toc.querySelector('details')!;
    const wide = matchMedia('(min-width: 85rem)');

    const applyWide = () => {
      if (wide.matches) details.open = true;
    };
    applyWide();
    wide.addEventListener('change', applyWide);

    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const targets = links
      .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
      .filter((el): el is HTMLElement => !!el);

    if (targets.length) {
      let current: HTMLAnchorElement | null = null;
      const mark = (el: Element) => {
        const next = links.find((a) => decodeURIComponent(a.hash.slice(1)) === el.id) ?? null;
        if (next === current) return;
        current?.removeAttribute('data-current');
        next?.setAttribute('data-current', '');
        current = next;
      };

      const io = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (visible[0]) mark(visible[0].target);
        },
        { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
      );
      targets.forEach((t) => io.observe(t));
    }

    // ── 떠다니는 단추와 시트 ────────────────────────────
    const fab = document.querySelector<HTMLElement>('[data-toc-fab]');
    const open = document.querySelector<HTMLButtonElement>('[data-toc-open]');
    const top = document.querySelector<HTMLButtonElement>('[data-toc-top]');
    const sheet = document.querySelector<HTMLElement>('[data-toc-sheet]');
    const list = sheet?.querySelector<HTMLElement>('[data-toc-list]');
    const source = toc.querySelector('ol');

    if (fab && open && top && sheet && list && source) {
      // 목차가 화면에 걸쳐 있으면 단추를 감춘다. PC 에서는 목차가 붙박이라
      // 늘 걸쳐 있으므로 단추가 나올 일이 없다
      new IntersectionObserver(([e]) => {
        fab.hidden = e.isIntersecting;
      }).observe(toc);

      const 닫기 = () => {
        sheet.hidden = true;
        open.setAttribute('aria-expanded', 'false');
        document.removeEventListener('keydown', 키);
        open.focus();
      };
      const 키 = (e: KeyboardEvent) => {
        if (e.key === 'Escape') 닫기();
      };
      const 열기 = () => {
        // 열 때마다 새로 복제한다. 지금 읽는 절 표시가 그대로 따라온다
        list.replaceChildren(source.cloneNode(true));
        list.scrollTop = 0;
        sheet.hidden = false;
        open.setAttribute('aria-expanded', 'true');
        document.addEventListener('keydown', 키);
        // 지금 읽는 절이 보이게 맞춘다
        list.querySelector('a[data-current]')?.scrollIntoView({ block: 'center' });
      };

      open.addEventListener('click', 열기);
      top.addEventListener('click', () => scrollTo(0, 0));
      sheet.querySelector('[data-toc-close]')!.addEventListener('click', 닫기);
      sheet.querySelector('[data-toc-dim]')!.addEventListener('click', 닫기);
      list.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) 닫기();
      });
    }
  }
</script>
