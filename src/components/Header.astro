---
import { SITE, NAV } from '../consts';
import Search from './Search.astro';
const here = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? here === '/' : here.startsWith(href));
---
<header class="site">
  <div class="shell row">
    <a class="wordmark" href="/">{SITE.title}</a>
    <nav aria-label="주요">
      {NAV.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
      {SITE.search && <Search />}
      <button type="button" class="theme" aria-label="어둡게" data-theme-toggle>
        {/* viewBox 와 그리는 크기를 1:1 로 맞추고 선을 짝수로 둔다.
            20 짜리를 15px 로 줄여 1.3 을 쓰면 0.975px 이 되어, 선이 픽셀 경계에
            안 떨어지고 양옆에 반투명 픽셀이 깔려 흐릿해 보인다 */}
        <svg class="moon" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
          <path
            d="M15.5 12.4A6.2 6.2 0 0 1 7.6 4.5a6.4 6.4 0 1 0 7.9 7.9Z"
            fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"
          />
        </svg>
        <svg class="sun" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
          <circle cx="10" cy="10" r="3.2" fill="none" stroke="currentColor" stroke-width="2" />
          <g stroke="currentColor" stroke-width="2">
            <path d="M10 1v3M10 16v3M1 10h3M16 10h3" />
            <path d="M4 4l2 2M14 14l2 2M16 4l-2 2M6 14l-2 2" />
          </g>
        </svg>
      </button>
    </nav>
  </div>
</header>

<style>
  .site { padding-block: 1.6rem 2.6rem; }
  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .wordmark {
    font-weight: 700;
    font-size: 1.02rem;
    letter-spacing: -0.015em;
    text-decoration: none;
  }
  nav {
    display: flex;
    align-items: baseline;
    gap: 1.1rem;
    font-size: 0.9rem;
  }
  nav a {
    color: var(--ink-dim);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1.5px solid transparent;
  }
  nav a:hover { color: var(--ink); }
  nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }
  .theme {
    align-self: center;
    background: none;
    border: 0;
    padding: 2px;
    /* 옆 메뉴 글자와 같은 색. --ink-faint 는 바탕 대비가 2.6 이라
       아이콘 기준(3:1)에 못 미치고, 나란히 선 메뉴보다 혼자 흐렸다 */
    color: var(--ink-dim);
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .theme:hover { color: var(--ink); }

  /* 밝을 때는 달(어둡게 하라), 어두울 때는 해(밝게 하라) */
  .theme .sun { display: none; }
  :global(:root[data-theme='dark']) .theme .moon { display: none; }
  :global(:root[data-theme='dark']) .theme .sun { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme .moon { display: none; }
    :global(:root:not([data-theme='light'])) .theme .sun { display: block; }
  }
</style>

<script>
  const root = document.documentElement;
  const btn = document.querySelector('[data-theme-toggle]');

  const isDark = () =>
    root.dataset.theme === 'dark' ||
    (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);

  const label = () => btn?.setAttribute('aria-label', isDark() ? '밝게' : '어둡게');
  label();

  btn?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch (e) {}
    label();
  });

  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', label);
</script>
