---
import { year as kstYear, monthDay, iso } from '../lib/date';
import type { CollectionEntry } from 'astro:content';

interface Props { posts: CollectionEntry<'posts'>[] }
const { posts } = Astro.props;
---
<ul class="rows">
  {posts.map((post) => (
    <li>
      <time datetime={iso(post.data.date)}>
        {kstYear(post.data.date)}.{monthDay(post.data.date)}
      </time>
      <a href={`/posts/${post.id}/`}>{post.data.title}</a>
    </li>
  ))}
</ul>

<style>
  .rows { list-style: none; margin: 0; padding: 0; }
  .rows li {
    display: flex;
    gap: 0.9rem;
    align-items: baseline;
    line-height: 2.05rem;
  }
  time {
    flex: none;
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-faint);
  }
  .rows a {
    text-decoration: none;
    word-break: keep-all;
    letter-spacing: -0.012em;
    border-bottom: 1px solid transparent;
  }
  .rows a:hover { border-bottom-color: var(--accent); }
</style>
