---
// Pagefind 검색. 색인은 빌드가 끝난 뒤 `pagefind --site dist` 가 만든다.
// 그래서 개발 중에는 비어 있고, 빌드한 결과에서만 작동한다.
---
<button type="button" class="searchbtn" aria-label="검색" data-search-open>
  <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true">
    <circle cx="9" cy="9" r="5.2" fill="none" stroke="currentColor" stroke-width="1.5" />
    <path d="M13 13l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
  </svg>
</button>

<dialog class="searchbox" data-search-dialog aria-label="글 검색">
  <div id="pagefind" />
</dialog>

<style>
  .searchbtn {
    align-self: center;
    background: none;
    border: 0;
    padding: 2px;
    color: var(--ink-faint);
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .searchbtn:hover { color: var(--ink); }

  .searchbox {
    width: min(42rem, calc(100vw - 2rem));
    margin: 8vh auto auto;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--bg);
    color: var(--ink);
    box-shadow: 0 16px 48px rgb(0 0 0 / 0.18);
  }
  .searchbox::backdrop { background: rgb(0 0 0 / 0.42); }
  #pagefind { padding: 0.9rem; }
</style>

<style is:global>
  /* Pagefind 기본 모양을 사이트 색에 맞춘다 */
  :root {
    --pagefind-ui-scale: 0.82;
    --pagefind-ui-primary: var(--ink);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--bg);
    --pagefind-ui-border: var(--rule);
    --pagefind-ui-tag: var(--bg-sunk);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 6px;
    --pagefind-ui-font: var(--font-sans);
  }
  .pagefind-ui__result-title a { color: var(--ink) !important; }
  .pagefind-ui__result-excerpt mark {
    background: none;
    color: var(--accent);
    font-weight: 600;
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  const openBtn = document.querySelector('[data-search-open]');
  let loaded = false;

  const open = async () => {
    if (!dialog) return;
    dialog.showModal();
    if (loaded) return;
    loaded = true;
    try {
      // 이 둘은 빌드가 끝난 뒤 pagefind 가 만든다.
      // ESM 이 아니라 전역(window.PagefindUI)에 붙는 스크립트다
      await new Promise<void>((resolve, reject) => {
        const css = document.createElement('link');
        css.rel = 'stylesheet';
        css.href = '/pagefind/pagefind-ui.css';
        document.head.appendChild(css);

        const js = document.createElement('script');
        js.src = '/pagefind/pagefind-ui.js';
        js.onload = () => resolve();
        js.onerror = () => reject(new Error('pagefind 없음'));
        document.head.appendChild(js);
      });

      const PagefindUI = (window as any).PagefindUI;
      if (!PagefindUI) throw new Error('pagefind 없음');

      new PagefindUI({
        element: '#pagefind',
        showSubResults: true,
        showImages: false,
        resetStyles: false,
        translations: {
          placeholder: '글 검색',
          clear_search: '지우기',
          load_more: '더 보기',
          search_label: '글 검색',
          zero_results: '[SEARCH_TERM] 에 대한 결과가 없습니다',
          many_results: '[SEARCH_TERM] — [COUNT] 건',
          one_result: '[SEARCH_TERM] — 1건',
          searching: '[SEARCH_TERM] 찾는 중…',
        },
      });
      setTimeout(() => dialog.querySelector('input')?.focus(), 60);
    } catch {
      const box = dialog.querySelector('#pagefind');
      if (box) {
        box.textContent = '검색은 빌드한 사이트에서만 됩니다 (npm run build).';
        (box as HTMLElement).style.color = 'var(--ink-dim)';
        (box as HTMLElement).style.fontSize = '0.9rem';
      }
    }
  };

  openBtn?.addEventListener('click', open);
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  // Cmd/Ctrl + K 로도 연다
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      dialog?.open ? dialog.close() : open();
    }
  });
</script>
