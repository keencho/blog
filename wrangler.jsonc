// Cloudflare Workers 배포 설정.
// 템플릿을 쓰는 사람은 `name` 만 자기 것으로 바꾸면 된다.
//
// `main` 이 없으므로 코드가 돌지 않는 순수 정적 서빙이다.
// 이 경우 요청은 과금되지 않는다 (Workers 무료 10만/일 한도와 무관).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog-keencho",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./dist",
    // 없는 주소는 Astro 가 만든 404 페이지로
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
